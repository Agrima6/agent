# Copy to .env.production on the server, fill in, then:  chmod 600 .env.production
# Never commit the real file.

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- LiveKit (same project the web client uses) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- AI providers ---
GROQ_API_KEY=
SARVAM_API_KEY=
# OPENAI_API_KEY=            # optional (semantic question retrieval); leave unset to use the local fallback

# --- Voice ---
TTS_PROVIDER=sarvam
TTS_GENDER=male
TURN_DETECTOR=local
VAD_MIN_SILENCE_S=0.4

# --- Shared secret the interview backend (client-service) sends to call this API ---
AGENT_SERVICE_KEY=change-me-to-a-long-random-string

# Host port the API listens on (localhost only). Change it if 8000 is already used on the server.
# API_HOST_PORT=8010

# Name this deployment's voice worker registers under in LiveKit, and the API dispatches to. Give the server its OWN
# name so a stray local agent (same LiveKit project) can never send interviews to it or take its jobs.
AGENT_NAME=workmate-prod

# Seconds the interviewer waits for the candidate to join before greeting (and a short pause after they arrive).
# CANDIDATE_WAIT_S=45
# CANDIDATE_SETTLE_S=1.2
