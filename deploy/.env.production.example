# Copy to .env.production on the server, fill in, then:  chmod 600 .env.production
# Never commit the real file.

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# --- LiveKit (same project the web client uses) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- AI providers ---
GROQ_API_KEY=
SARVAM_API_KEY=
# OPENAI_API_KEY=            # optional (semantic question retrieval); leave unset to use the local fallback

# --- Voice ---
TTS_PROVIDER=sarvam
TTS_GENDER=male
TURN_DETECTOR=local
VAD_MIN_SILENCE_S=0.4

# --- Shared secret the interview backend (client-service) sends to call this API ---
AGENT_SERVICE_KEY=change-me-to-a-long-random-string
