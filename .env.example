# --- Groq (free tier, no card required) — LLM + Whisper STT ---
GROQ_API_KEY=your_groq_api_key_here

# --- ElevenLabs (free tier, no card required) — TTS ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- Only needed if you switch back to OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here

# --- LiveKit Cloud (get from https://cloud.livekit.io) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Local app ---
DATABASE_URL=sqlite:///./workmate.db
API_BASE_URL=http://localhost:8000

# --- TTS Voice Configuration ---
# Options: "sarvam", "edge", "elevenlabs", "openai"
TTS_PROVIDER=sarvam

# --- Sarvam AI (Bulbul v3 / v2) ---
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=anushka
SARVAM_LANGUAGE_CODE=en-IN
