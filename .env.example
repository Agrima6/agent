# --- Groq (free tier, no card required) — LLM + Whisper STT ---
GROQ_API_KEY=your_groq_api_key_here

# --- ElevenLabs (free tier, no card required) — TTS ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- Only needed if you switch back to OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here

# --- LiveKit Cloud (get from https://cloud.livekit.io) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Local app ---
DATABASE_URL=sqlite:///./workmate.db
API_BASE_URL=http://localhost:8000

# --- TTS Voice Configuration ---
# Options: "sarvam", "edge", "elevenlabs", "openai"
TTS_PROVIDER=sarvam

# --- Sarvam AI (Bulbul v3) ---
SARVAM_API_KEY=your_sarvam_api_key_here
# Voice/pace are resolved per language+gender in voice_config.py (calibrated to ~150 wpm).
# The legacy SARVAM_PACE / SARVAM_SPEAKER / SARVAM_LANGUAGE_CODE / SARVAM_SAMPLE_RATE vars are IGNORED.
# Optional overrides (leave unset normally):
# TTS_SPEAKER_OVERRIDE=ratan
# TTS_PACE_OVERRIDE=0.75
# TTS_GENDER=male
# TTS_SAMPLE_RATE=24000

# --- LLM provider (judge/composer for interview behaviour) ---
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# JUDGE_MODEL=openai/gpt-oss-120b
# COMPOSER_MODEL=openai/gpt-oss-20b

# --- Realtime latency tuning (see turn_trace.py; every turn logs a `turn_trace` line with its waterfall) ---
# End-of-turn detector: local (default, on-device, same in dev and prod) | vad (no model, fastest, may cut off
# pausing candidates) | cloud (LiveKit cloud model, adds a network round trip and a 1 s timeout when it fails)
# TURN_DETECTOR=local
# Seconds of silence before the candidate is considered done speaking (Silero default was 0.55)
# VAD_MIN_SILENCE_S=0.4
